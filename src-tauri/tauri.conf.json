{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mkv",
  "version": "0.1.0",
  "identifier": "com.root.mkv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mkv",
        "width": 800,
        "height": 600,
        "center": true,
        "decorations": false,
        "backgroundColor": "#0d1220"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": "all",
    "resources": [
      "binaries/ffm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
